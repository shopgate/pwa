<!doctype html>
<html data-disallow-pull-to-refresh="1">

<head>
  <meta charset="utf-8">
  <meta id="libshopgate">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <title>
    <%= htmlWebpackPlugin.options.title %>
  </title>
  <meta name="emotion-insertion-point" content="" />
  <% if (htmlWebpackPlugin.files && htmlWebpackPlugin.files.css) { %>
    <% htmlWebpackPlugin.files.css.forEach(function(css) { %>
      <link rel="stylesheet" href="<%= css %>">
    <% }) %>
  <% } %>
  <%
    // Anchors for the new theming system. Layers must apply in a fixed order:
    // emotion-insertion-point (all tss styles) -> theme css -> preview css.
    //
    // TSS styles carry defaults generated during theme initialization.
    // The theme css file (the themeCssUrl setting, loaded by loadThemeCss) overrides them.
    // The admin preview (FrontendSettingsPreviewBridge) overrides both for live customizations.
    //
    // All three have the same specificity, so document order is decisive.
    // Declaring both insertion positions here makes the order structural instead of timing-based.
  %>
  <meta name="theme-css-insertion-point" content="" />
  <meta name="preview-css-insertion-point" content="" />
  <% const scripts = htmlWebpackPlugin.files.js; %>
  <% const vendor = scripts.find(s => s.includes('vendor')); %>
  <% if (vendor) { %><script src="<%= vendor %>"></script><% } %>
  <script>
    var SGConnect = {
      appId: "<%- htmlWebpackPlugin.options.appId %>"
    };
  </script>
  <% if (htmlWebpackPlugin.options.webBridge) { %>
    <script src="<%= htmlWebpackPlugin.options.webBridge %>"></script>
  <% } %>
</head>

<body>
  <div id="root"></div>
  <div id="portals"></div>
  <% for (const js of scripts) { if (js !== vendor) { %>
    <script src="<%= js %>"></script>
  <% }} %>
</body>

</html>
