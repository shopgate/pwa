{
  "extends": "@shopgate/engage/tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "constants/**/*.js",
    "helpers/redux/**/*.js"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.spec.*",
    "**/__tests__/**",
    "**/__snapshots__/**",
    "coverage"
  ]
}
