{
  "extends": "@shopgate/engage/tsconfig.build.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {}
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "actions/**/*.js",
    "constants/**/*.js",
    "helpers/**/*.js",
    "selectors/**/*.js",
    "streams/**/*.js"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.spec.*",
    "**/spec.js",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/__snapshots__/**",
    "coverage"
  ]
}
