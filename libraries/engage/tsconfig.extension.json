{
  "compilerOptions": {
    "target": "es2019",
    "lib": ["DOM", "ES2019"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["@shopgate/engage/untyped-modules", "jest", "node"],
    "paths": {
      "@shopgate/engage/*": ["./*"],
      "@shopgate/pwa-common/*": ["../pwa-common/*", "../common/*"],
      "@shopgate/pwa-common-commerce/*": ["../pwa-common-commerce/*", "../commerce/*"],
      "@shopgate/pwa-core/*": ["../pwa-core/*", "../core/*"],
      "@shopgate/pwa-tracking/*": ["../pwa-tracking/*", "../tracking/*"],
      "@shopgate/pwa-ui-ios/*": ["../pwa-ui-ios/*", "../ui-ios/*"],
      "@shopgate/pwa-ui-material/*": ["../pwa-ui-material/*", "../ui-material/*"],
      "@shopgate/pwa-ui-shared/*": ["../pwa-ui-shared/*", "../ui-shared/*"],
      "@shopgate/pwa-webcheckout-shopify/*": ["../pwa-webcheckout-shopify/*", "../webcheckout/*"],
      "@shopgate/tracking-core/*": ["../tracking-core/*"]
    },

    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  }
}
