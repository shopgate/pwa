{
  "extends": "./tsconfig.build.base.json",
  "compilerOptions": {
    "paths": {
      "@shopgate/engage": ["./index.js"],
      "@shopgate/engage/*": ["./*"],
      "tss-react/tools/*": ["../../node_modules/tss-react/tools/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "*/index.js",
    "*/*/index.js",
    "*/*/index.jsx"
  ]
}
