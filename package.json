{
  "name": "@shopgate/pwa",
  "version": "7.0.0",
  "private": true,
  "workspaces": [
    "extensions/@shopgate-theme-config/frontend",
    "libraries/*",
    "themes/*",
    "utils/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shopgate/pwa.git"
  },
  "changelog": {
    "cacheDir": ".changelog",
    "labels": {
      "enhancement": ":rocket: Enhancement",
      "bug": ":bug: Bug Fix",
      "feature": ":rocket: New Feature",
      "breaking": ":boom: Breaking Change",
      "polish": ":nail_care: Polish",
      "internal": ":house: Internal",
      "docs": ":memo: Documentation"
    }
  },
  "scripts": {
    "start": "sgconnect frontend start",
    "setup": "sgconnect init && npm install",
    "clean": "npm ci",
    "test": "RUN_LONG=true jest",
    "test:short": "jest",
    "test:watch": "jest --watch",
    "cover": "jest --coverage",
    "lint": "eslint --quiet --ignore-pattern extensions --ext .js --ext .jsx --ext .ts --ext .tsx --ext .json .",
    "lint:summary": "eslint --ignore-pattern extensions --ext .js --ext .jsx --ext .ts --ext .tsx --ext .json . -f summary",
    "release": "node scripts/release/cli.ts",
    "release:typecheck": "tsc -p scripts/release",
    "release:test": "node --test 'scripts/release/**/*.test.ts'",
    "start-cloud": "sgconnect backend start & sgconnect frontend start",
    "lint-staged": "lint-staged",
    "resetup": "npm ci"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "eslint",
    "scripts/release/**/*.ts": "bash -c 'node_modules/.bin/tsc -p scripts/release'"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^17.0.93",
    "baseline-browser-mapping": "^2.10.42",
    "detector": "^2.5.0",
    "eslint": "^8.57.1",
    "eslint-formatter-summary": "^1.1.0",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "husky": "^1.0.0-rc.13",
    "jest": "^29.7.0",
    "lint-staged": "^12.5.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "rxjs": "~5.5.12"
  },
  "dependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@sigmacomputing/babel-plugin-lodash": "3.3.5",
    "babel-plugin-module-resolver": "^4.1.0",
    "babel-plugin-transform-react-remove-prop-types": "^0.4.24",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "enzyme": {
      "cheerio": "1.0.0-rc.3"
    }
  },
  "allowScripts": {
    "husky@1.3.1": true,
    "core-js": false,
    "core-js-pure": false,
    "fsevents": false
  }
}
